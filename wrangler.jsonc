{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hospital-ledger",
	"main": "dist/index.js",
	"compatibility_date": "2025-11-01",
	"cache": { "enabled": true },
	// enable_request_signal: a Stop click (client disconnect) reaches the /api/faq/ask
	// handler as request.signal so the model stream is cancelled instead of running to
	// its end (developers.cloudflare.com/workers/runtime-apis/request/, read 2026-09-18).
	"compatibility_flags": ["nodejs_compat", "enable_request_signal"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "hospitalledger.com", "custom_domain": true },
		{ "pattern": "www.hospitalledger.com", "custom_domain": true }
	],
	"vars": {
		"SITE_NAME": "Hospital Ledger"
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "none"
	},
	"r2_buckets": [
		{
			"binding": "HL_MRF_RAW",
			"bucket_name": "hl-mrf-raw"
		},
		{
			"binding": "HL_MRF_PARSED",
			"bucket_name": "hl-mrf-parsed"
		}
	],
	"observability": {
		"enabled": true
	},
	// Workers AI for the "Ask anything" row (src/faq/faq-route.ts). `remote: true`
	// makes `wrangler dev` call the real model instead of a local stub.
	"ai": { "binding": "AI", "remote": true },
	// 20 questions per minute per client IP on /api/faq/ask. namespace_id is
	// account-unique: aivaclaims 2026091801, improvebayarea 2026091802,
	// improvecortland 2026091803, this worker 2026091804.
	"ratelimits": [
		{
			"name": "FAQ_RATE_LIMITER",
			"namespace_id": "2026091804",
			"simple": { "limit": 20, "period": 60 }
		}
	]
}
