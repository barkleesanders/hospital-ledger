{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hospital-ledger",
	"main": "dist/index.js",
	"compatibility_date": "2025-11-01",
	"cache": { "enabled": true },
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "hospitalledger.com", "custom_domain": true },
		{ "pattern": "www.hospitalledger.com", "custom_domain": true }
	],
	"vars": {
		"SITE_NAME": "Hospital Ledger"
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "none",
		// These two are R2-first (meta/summary.json, meta/hospitals.json) so the
		// refresh task can update the live site without a deploy; the bundled
		// static copies are the fallback the Worker reaches for itself.
		"run_worker_first": ["/data/summary.json", "/data/hospitals.json"]
	},
	"r2_buckets": [
		{
			"binding": "HL_MRF_RAW",
			"bucket_name": "hl-mrf-raw"
		},
		{
			"binding": "HL_MRF_PARSED",
			"bucket_name": "hl-mrf-parsed"
		}
	],
	"observability": {
		"enabled": true
	}
}
