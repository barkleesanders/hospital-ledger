__pycache__/
*.pyc
.beads/cache/
.venv/
chunks/
results/
/tmp/
*.log
*.db-journal

# Generated crawler/parser bulk artifacts. These are uploaded to R2, not GitHub.
data/parsed/
data/raw/
data/_pages_bundle*/
data/full_standardize_shards/
data/gap_shards/
data/*.log

# Cloudflare local cache.
site/.wrangler/

# Keep the slim preview index in Git, but not per-hospital preview payloads.
site/data/prices/*.json
!site/data/prices/index.json

# Keep CPT indexes, but do not commit any future per-CPT payload directory.
site/data/cpt/

# Large preview artifacts (use R2)
site/data/cpt-index.json
site/data/prices/*.json
!site/data/prices/index.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Hono migration: Node + build outputs
node_modules/
dist/
.wrangler/
.dev.vars
