__pycache__/
*.pyc
.beads/cache/
.venv/
chunks/
results/
/tmp/
*.log
*.db-journal

# Generated crawler/parser bulk artifacts. These are uploaded to R2, not GitHub.
data/parsed/
data/parse_errors/
data/raw/
data/_pages_bundle*/
data/full_standardize_shards/
data/gap_shards/
data/*.log

# Slim side-car accumulators — full-corpus build artifacts, not source.
# build_aggregates.py consumes them; regenerated by every full slim run.
# _cpt_detail_raw.jsonl in particular reaches multi-GB. Never commit.
data/_cpt_detail_raw.jsonl
data/_payer_raw.jsonl
data/_compliance_per_hospital.jsonl

# Cloudflare local cache.
site/.wrangler/
.wrangler/

# Keep the slim preview index in Git, but not per-hospital preview payloads.
site/data/prices/*.json
!site/data/prices/index.json
public/data/prices/*.json
!public/data/prices/index.json

# Keep CPT indexes, but do not commit any future per-CPT payload directory.
site/data/cpt/
public/data/cpt/

# Large preview artifacts (use R2)
site/data/cpt-index.json
site/data/prices/*.json
!site/data/prices/index.json
public/data/cpt-index.json
public/data/cpt-detail/
public/data/payer/
public/data/payers-index.json
public/data/compliance-ranking.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Hono migration: Node + build outputs
node_modules/
dist/
.wrangler/
.dev.vars
.prices_build_stash/

# Beads / Dolt files (added by bd init)
.beads/proxieddb/
*.gate.lock*

# scratch output of scripts/refresh_counts.sh (contract tree, uploaded to R2)
data/site-out/
data/refresh_logs/

# Pattern-43 constrained probe (tests/probe-constrained.mjs): playwright symlink + outputs
tests/node_modules
tests/probe-*.json
tests/probe-*.png
.ship/

# stale lockfile — npm (package-lock.json) is the active manager; bun.lock dated from the scaffold and confused the wrangler-autoupdate hook (2026-09-18)
bun.lock
