[Unit]
Description=Hospital Ledger Tier 3 go-live publish (gen-20260923-vm)
After=network-online.target
Wants=network-online.target
StartLimitBurst=5

[Service]
Type=simple
User=root
Environment=HOME=/home/hatch
EnvironmentFile=/home/hatch/hospital-ledger.env
EnvironmentFile=/home/hatch/hl-proxy.env
WorkingDirectory=/home/hatch/workspace/goals/hospital-ledger-weekly-refresh-counts-tier/hidden_files
ExecStart=/usr/bin/python3 vm_publish.py
Restart=on-failure
RestartSec=300
StandardOutput=append:/home/hatch/workspace/goals/hospital-ledger-weekly-refresh-counts-tier/hidden_files/vm-publish.log
StandardError=append:/home/hatch/workspace/goals/hospital-ledger-weekly-refresh-counts-tier/hidden_files/vm-publish.log

[Install]
WantedBy=multi-user.target
